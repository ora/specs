{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ora/specs/blob/main/schema/spec.schema.json",
  "title": "Agent protocol spec entry (specs/<id>/spec.yaml)",
  "description": "One spec the registry tracks: who publishes it, its versions, and the state Ora last reviewed (or, with reviewed: null, the state it started watching). Upstream facts (versions, links) are separate from the reviewed pin; which version each consumer runs is not recorded here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "homepage", "spec_url", "versions", "reviewed"],
  "properties": {
    "id": {
      "description": "Lowercase words and hyphens; equals the folder name.",
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 40
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "homepage": { "$ref": "#/$defs/https_url" },
    "spec_url": {
      "description": "The living spec: always the newest text. May hold {version} (the reviewed version).",
      "$ref": "#/$defs/https_url_template"
    },
    "revision_url": {
      "description": "Address of a named revision, for specs that publish revisions somewhere other than their repository folder. Holds {revision}.",
      "type": "string",
      "pattern": "^https://[^\\s]*\\{revision\\}[^\\s]*$",
      "maxLength": 300
    },
    "versions": {
      "description": "Newest first. `status` drives version accept lists in consumers: current (the one stable version to teach; at most one), preview (newer and still in progress), supported (older, still valid and accepted), deprecated (recognized as a legacy era, never taught).",
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,39}$" },
          "status": { "enum": ["current", "preview", "supported", "deprecated"] },
          "label": { "type": "string", "minLength": 1, "maxLength": 80 },
          "url": { "$ref": "#/$defs/https_url" },
          "published": { "$ref": "#/$defs/date" }
        }
      }
    },
    "reviewed": {
      "description": "The state Ora read and turned into rules. Null while the spec is only watched; its sources then live in `watch`.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "read", "skill", "sources"],
          "properties": {
            "version": {
              "description": "The reviewed version's id from `versions`, or null for a spec that publishes no versions.",
              "type": ["string", "null"]
            },
            "read": { "description": "The day the reviewed state was read.", "$ref": "#/$defs/date" },
            "skill": {
              "description": "The skill in skills/ that holds this spec's rules, or null when it has none yet.",
              "type": ["string", "null"],
              "pattern": "^protocol-[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "label": {
              "description": "How a person names the reviewed state, when the first source's pin is not itself a named revision. May hold {version}, {read}, {pin}, {pin7}, {commit} (from the first source).",
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "url": {
              "description": "The reviewed state's own address, with the same placeholders as `label`. Null when it has none (a Git blob or tree, a page digest).",
              "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/https_url_template" }]
            },
            "sources": { "$ref": "#/$defs/sources" }
          }
        }
      ]
    },
    "watch": {
      "description": "Sources of a spec with reviewed: null, pinned to the state seen when it was added.",
      "$ref": "#/$defs/sources"
    },
    "notes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sdk_ceiling": {
          "description": "Ecosystem lag: the newest revision the main SDK speaks.",
          "type": "object",
          "additionalProperties": false,
          "required": ["package", "protocol"],
          "properties": {
            "package": { "type": "string", "pattern": "^(@[a-z0-9-]+/)?[a-z0-9._-]+$" },
            "protocol": { "type": "string", "pattern": "^[A-Za-z0-9._+-]{1,40}$" }
          }
        }
      }
    },
    "issue": {
      "description": "Overrides for this spec's drift issue text. {id} {name} {page} {file} are filled in.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "impact": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "todo": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    }
  },
  "if": { "properties": { "reviewed": { "type": "null" } } },
  "then": { "required": ["watch"] },
  "else": { "not": { "required": ["watch"] } },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "https_url": { "type": "string", "pattern": "^https://[^\\s{}]+$", "maxLength": 300 },
    "https_url_template": { "type": "string", "pattern": "^https://[^\\s]+$", "maxLength": 300 },
    "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "path": { "type": "string", "pattern": "^[^-\\s][^\\s]*$", "maxLength": 200 },
    "match": { "type": "string", "pattern": "^\\^.*\\$$", "maxLength": 200 },
    "pin": { "type": "string", "minLength": 1, "maxLength": 200 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "repo", "path", "pin"],
            "properties": {
              "kind": { "const": "git-path" },
              "repo": { "$ref": "#/$defs/repo" },
              "path": { "$ref": "#/$defs/path" },
              "commit": { "description": "The commit the reviewed blob or tree was read at, for links.", "type": "string", "pattern": "^[0-9a-f]{40}$" },
              "pin": { "$ref": "#/$defs/pin" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "repo", "pin"],
            "properties": { "kind": { "const": "git-head" }, "repo": { "$ref": "#/$defs/repo" }, "pin": { "$ref": "#/$defs/pin" } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "repo", "path", "pin"],
            "properties": {
              "kind": { "const": "git-dated-dirs" },
              "repo": { "$ref": "#/$defs/repo" },
              "path": { "$ref": "#/$defs/path" },
              "pin": { "$ref": "#/$defs/pin" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "repo", "match", "pin"],
            "properties": {
              "kind": { "const": "git-latest-tag" },
              "repo": { "$ref": "#/$defs/repo" },
              "match": { "$ref": "#/$defs/match" },
              "pin": { "$ref": "#/$defs/pin" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "repo", "path", "match", "pin"],
            "properties": {
              "kind": { "const": "git-latest-file" },
              "repo": { "$ref": "#/$defs/repo" },
              "path": { "$ref": "#/$defs/path" },
              "match": { "$ref": "#/$defs/match" },
              "pin": { "$ref": "#/$defs/pin" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "name", "pin"],
            "properties": {
              "kind": { "const": "ietf-draft" },
              "name": { "type": "string", "pattern": "^draft-[a-z0-9-]+$" },
              "pin": { "$ref": "#/$defs/pin" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "number", "pin"],
            "properties": {
              "kind": { "const": "rfc" },
              "number": { "type": "integer", "minimum": 1, "maximum": 99999 },
              "pin": { "$ref": "#/$defs/pin" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "url", "pin"],
            "properties": { "kind": { "const": "page" }, "url": { "$ref": "#/$defs/https_url" }, "pin": { "$ref": "#/$defs/pin" } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "url", "field", "pin"],
            "properties": {
              "kind": { "const": "json-field" },
              "url": { "$ref": "#/$defs/https_url" },
              "field": { "type": "string", "pattern": "^[A-Za-z0-9_]+(?:\\.[A-Za-z0-9_]+)*$" },
              "pin": { "$ref": "#/$defs/pin" }
            }
          }
        ]
      }
    }
  }
}
